[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/hseeda/10L-H-Claw.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "master"]
	remote = origin
	merge = refs/heads/master
	vscode-merge-base = origin/master
[branch "onBoard"]
	vscode-merge-base = origin/master
	remote = origin
	merge = refs/heads/onBoard
[branch "Heartbeat"]
	vscode-merge-base = origin/onBoard
	remote = origin
	merge = refs/heads/Heartbeat
